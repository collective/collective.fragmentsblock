<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:genericsetup="http://namespaces.zope.org/genericsetup"
    i18n_domain="collective.fragmentsblock">

  <genericsetup:registerProfile
      name="1001"
      title="collective.fragmentsblock: upgrade to 1001"
      directory="1001"
      provides="Products.GenericSetup.interfaces.EXTENSION"
      />

  <genericsetup:upgradeSteps
      source="1000"
      destination="1001"
      profile="collective.fragmentsblock:default">

    <genericsetup:upgradeStep
        title="Declare block-api 1.2 on the fragment block record"
        description="The editor bundle&#39;s install() is asynchronous; a host that awaits it stamps block-api 1.2."
        handler=".v1001.upgrade"
        />

    <genericsetup:upgradeDepends
        title="Apply profile version 1001"
        import_profile="collective.fragmentsblock.upgrades:1001"
        />

  </genericsetup:upgradeSteps>

</configure>
