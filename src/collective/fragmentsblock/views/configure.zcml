<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:browser="http://namespaces.zope.org/browser"
    i18n_domain="collective.fragmentsblock">

  <browser:page
      name="aurora-block-fragment"
      for="*"
      class=".fragment_block_view.FragmentBlockView"
      permission="zope2.View"
      layer="collective.fragmentsblock.interfaces.ICollectiveFragmentsblockLayer"
      />

</configure>
