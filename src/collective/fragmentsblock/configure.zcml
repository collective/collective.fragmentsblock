<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:genericsetup="http://namespaces.zope.org/genericsetup"
    xmlns:i18n="http://namespaces.zope.org/i18n"
    xmlns:plone="http://namespaces.plone.org/plone"
    i18n_domain="collective.fragmentsblock">

  <i18n:registerTranslations directory="locales" />

  <include file="permissions.zcml" />

  <genericsetup:registerProfile
      name="default"
      title="Collective Fragmentsblock"
      description="Aurora fragment block: static design fragments registered by add-ons, rendered as-is"
      provides="Products.GenericSetup.interfaces.EXTENSION"
      directory="profiles/default"
      />

  <genericsetup:registerProfile
      name="uninstall"
      title="Collective Fragmentsblock (uninstall)"
      description="Uninstalls collective.fragmentsblock"
      provides="Products.GenericSetup.interfaces.EXTENSION"
      directory="profiles/uninstall"
      />

  <genericsetup:importStep
      name="collective.fragmentsblock-uninstall"
      title="Collective Fragmentsblock uninstall"
      description="Uninstall collective.fragmentsblock"
      handler="collective.fragmentsblock.setuphandlers.uninstall"
      />


  <include package=".views" />

  <!-- Serves the committed editor bundle + scope-wrapped CSS as
       ++plone++collective.fragmentsblock/... (block add-on contract §3.1:
       committed artifacts, no Node at install time). -->
  <plone:static
      name="collective.fragmentsblock"
      type="plone"
      directory="static"
      />

</configure>
